<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FormHelper</PackageId>
    <Description>Transform server-side validations to client-side without writing any javascript code. Ajax forms, validation messages and notifications for ASP.NET Core MVC and Razor Pages. Works with or without jQuery. (Compatible with Fluent Validation)</Description>
    <PackageTags>aspnetcore mvc razorpages form ajax validation clientside fluentvalidation notification toastr</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Client assets are embedded and served by app.UseFormHelper() under /formhelper/ -->
  <ItemGroup>
    <None Remove="Scripts\**;Styles\**" />
    <EmbeddedResource Include="Scripts\formhelper*.js;Styles\formhelper*.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FormHelper.Tests" />
  </ItemGroup>

</Project>
