@{
    ViewData["page"] = Page.HtmlHelper;
}

@model ProductFormViewModel

@{
    var formConfig = new FormConfig(ViewContext)
    {
        FormId = "ProductForm",
        BeforeSubmit = "ProductFormBeforeSubmit", // optional
        Callback = "ProductFormCallback", // optional
        // EnableButtonAfterSuccess = true, // default => false
        // ResetFormAfterSuccess = false // default => true
        // DataType = FormDataType.Json // default => FormData
        // ToastrPosition = ToastrPosition.BottomLeft // default => TopRight
    };
}

<div class="row justify-content-center">
    <div class="col col-lg-8">
        <div class="card">
            <div class="card-header">
                @(Model.IsNew ? "New Product" : "Edit Product")
            </div>
            <div class="card-body">
                <form id="@formConfig.FormId" asp-controller="Home" asp-action="Save" enctype="multipart/form-data">

                    <partial name="_ProductFields" />

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary" type="reset">Reset</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </form>

                @* Adds the FormHelper attributes to the form above. *@
                @Html.RenderFormScript(formConfig)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function ProductFormBeforeSubmit() {
            console.log("BeforeSubmit function!", arguments);
        }

        function ProductFormCallback(result) {
            console.log("Callback function!", result);
        }
    </script>
}
