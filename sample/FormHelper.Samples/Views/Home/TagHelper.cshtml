@{
    ViewData["page"] = Page.TagHelper;
}

@model ProductFormViewModel

<div class="row justify-content-center">
    <div class="col col-lg-8">
        <div class="card">
            <div class="card-header">
                @(Model.IsNew ? "New Product" : "Edit Product")
            </div>
            <div class="card-body">
                <!-- You can use <form asp-formhelper="true"> or <formhelper> to activate formhelper. -->
                <form id="sample-form" asp-formhelper="true" asp-controller="Home" asp-action="Save" asp-dataType="FormData"
                      asp-callback="ProductFormCallback" asp-beforeSubmit="ProductFormBeforeSubmit"
                      asp-enableButtonAfterSuccess="true" asp-resetFormAfterSuccess="false"
                      asp-checkTheFormFieldsMessage="Please check the product fields."
                      enctype="multipart/form-data">

                    <partial name="_ProductFields" />

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary" type="button" onclick="FormHelper.reset(this.form)">Reset</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function ProductFormBeforeSubmit() {
            console.log("BeforeSubmit function!", arguments);
        }

        function ProductFormCallback(result) {
            console.log("Callback function!", result);
        }
    </script>
}
